{
	"name": "premier-league-history",
	"main": ".open-next/worker.js",
	"compatibility_date": "2024-12-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "pl-history-db",
			"database_id": "0db91852-71d7-4355-a296-5760f6a35587",
			"remote": true
		}
	],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
}
}